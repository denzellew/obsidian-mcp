# Dev environment for `mise run tunnel` / `mise run doctor`.
# Copy to .env (gitignored) and fill in. These are for LOCAL DEVELOPMENT only —
# production runs the tunnel as a docker-compose sidecar (see deploy/).
#
# Bun auto-loads .env, so `mise run tunnel` picks these up.

# Optional: dev server port (default 3000). Tunnels forward to localhost:$PORT.
# PORT=3000

# --- gatecrash (https://github.com/jclement/gatecrash) ---
# Set all three to have `mise run tunnel` start gatecrash (if the binary is on PATH).
# GATECRASH_SERVER=tunnel.example.com:51234
# GATECRASH_HOST_KEY=SHA256:...
# GATECRASH_TOKEN=obsidian-mcp:SECRET
# GATECRASH_TARGET defaults to localhost:$PORT; override only if needed.

# --- cloudflared ---
# Set the token to have `mise run tunnel` start cloudflared (if the binary is on PATH).
# Configure the tunnel's public hostname to point at http://localhost:$PORT.
# CLOUDFLARED_TUNNEL_TOKEN=eyJ...

# Binary overrides (if not on PATH under the default name):
# GATECRASH_BIN=gatecrash
# CLOUDFLARED_BIN=cloudflared
